{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "edassure-web",
	"main": "src/index.ts",
	"compatibility_date": "2025-09-01",
	"observability": {
		"enabled": true
	},
	// Static files in ./public are served by the Workers static-assets feature. The Worker script runs first
	// so it can add security headers and serve /config.js (the backend URL) from an environment variable.
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": true,
		"not_found_handling": "single-page-application"
	},
	"vars": {
		// URL of the deployed backend worker (edassure-api), no trailing slash.
		"API_BASE_URL": "https://edassure-api.sriramkirand.workers.dev"
	}
}
